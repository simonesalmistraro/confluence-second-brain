{
  // Project-level opencode config. Loaded automatically for anyone who runs
  // `opencode` from this repo. Schema: https://opencode.ai/config.json
  "$schema": "https://opencode.ai/config.json",

  // Default model for daily retrieval/answer loops. Pick a cheap tier; the
  // vault does the heavy lifting, not the model.
  "model": "openai/gpt-5.6-luna",

  "mcp": {
    // Basic Memory: hybrid search + knowledge graph over the whole vault
    // (mirror + notes). Core retrieval path, enabled everywhere.
    // --project pins the repo vault (bootstrap registers this name), so retrieval
    // never depends on the machine's global default project. basic-memory reserves
    // 'main' for its own data dir, which is why we use a dedicated name here.
    "basic-memory": {
      "type": "local",
      "command": ["uvx", "basic-memory", "mcp", "--project", "confluence-second-brain"],
      "enabled": true
    },

    // Atlassian MCP (github.com/sooperset/mcp-atlassian), run locally. Used
    // for writes and fresh point-reads.
    //
    // Handles BOTH Confluence Cloud and Server/Data Center 6.0+. The
    // deployment is chosen by which env vars you export, not by this file:
    //   Cloud      CONFLUENCE_URL + CONFLUENCE_USERNAME + CONFLUENCE_API_TOKEN
    //   Server/DC  CONFLUENCE_URL + CONFLUENCE_PAT   (Personal Access Token)
    // Vars for the other deployment stay empty and are ignored.
    //
    // Server/DC: CONFLUENCE_URL must include the context path if your instance
    // has one, e.g. https://wiki.example.com/confluence
    //
    // Never inline a token or a hostname here — this file is committed.
    // See scripts/env.example.sh.
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian"],
      "environment": {
        "CONFLUENCE_URL": "{env:CONFLUENCE_URL}",
        "CONFLUENCE_USERNAME": "{env:CONFLUENCE_USERNAME}",
        "CONFLUENCE_API_TOKEN": "{env:CONFLUENCE_API_TOKEN}",
        "CONFLUENCE_PERSONAL_TOKEN": "{env:CONFLUENCE_PAT}",
        "CONFLUENCE_SPACES_FILTER": "{env:CONFLUENCE_SPACES}"
      },
      // First run resolves the package via uvx, which blows past the 5s default.
      "timeout": 60000,
      "enabled": true
    }
  },

  // The Atlassian server ships many tool schemas and they cost tokens on
  // every prompt. Disabled globally; only the confluence-writer agent pays.
  "tools": {
    "atlassian*": false
  },

  "agent": {
    // Explicit agent for Confluence writes and synthesis jobs. Uses a
    // stronger model tier: writes are rarer and worth the spend.
    "confluence-writer": {
      "description": "Creates and updates Confluence pages via the Atlassian MCP. Use for any write-back to the wiki.",
      "model": "openai/gpt-5.6-terra",
      "tools": {
        "atlassian*": true
      }
    }
  }
}
